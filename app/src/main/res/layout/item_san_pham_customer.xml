<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Khung Ảnh Nông Sản -->
        <FrameLayout
            android:id="@+id/layoutKhungAnh"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgSanPham"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@android:drawable/ic_menu_gallery" />

            <!-- Huy hiệu Chứng nhận (VietGAP / Hữu cơ) -->
            <TextView
                android:id="@+id/tvBadgeChungNhan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/badge_danh_muc"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="VietGAP"
                android:textColor="@color/primary_green"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Lớp phủ Hết Hàng (Chỉ hiện khi tonKho <= 0) -->
            <TextView
                android:id="@+id/tvHetHangOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99000000"
                android:gravity="center"
                android:text="HẾT HÀNG"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Tên Nông Sản (In đậm, tối đa 2 dòng) -->
        <TextView
            android:id="@+id/tvTenSanPham"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:text="Cà Chua Beef Hữu Cơ"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutKhungAnh" />

        <!-- Tên Trang Trại / Nhà Vườn -->
        <TextView
            android:id="@+id/tvTenTrangTrai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Đà Lạt Eco Farm"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTenSanPham" />

        <!-- Giá bán & Nút Thêm Giỏ Hàng Nhanh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTenTrangTrai">

            <TextView
                android:id="@+id/tvGia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="45.000 đ"
                android:textColor="@color/primary_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Nút tròn thêm nhanh vào giỏ hàng ("+") -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemNhanh"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:backgroundTint="@color/primary_green"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="17dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

