<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:padding="20dp"
    tools:context=".ui.admin.AdminMainActivity">

    <!-- Header Bảng Điều Khiển Admin -->
    <TextView
        android:id="@+id/tvAdminHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Bảng Điều Khiển Admin"
        android:textColor="@color/primary_green"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAdminSubHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Hệ thống quản lý sàn nông sản sạch AgriClean"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAdminHeader" />

    <!-- Nút Đăng Xuất (UC03) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDangXuat"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đăng xuất"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="13sp"
        app:icon="@android:drawable/ic_lock_power_off"
        app:iconTint="@android:color/holo_red_dark"
        app:layout_constraintBottom_toBottomOf="@id/tvAdminSubHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAdminHeader" />

    <!-- Thẻ 1: Quản lý Sản phẩm (UC14) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuanLySanPham"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAdminSubHeader"
        app:strokeColor="@color/divider_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Icon đầu mục trong khối bo góc 12dp nền xanh pastel -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="@color/primary_green_light"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📦"
                        android:textSize="20sp" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quản Lý Nông Sản "
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Thêm mới, sửa, xóa &amp; tạo mã QR"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Quản lý toàn bộ danh mục sản phẩm sạch, cập nhật thông tin nhà vườn, tiêu chuẩn VietGAP và tạo mã QR truy xuất."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Nút bấm dạng pill shape -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuanLySanPham"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="MỞ QUẢN LÝ SẢN PHẨM"
                android:textColor="@color/primary_green"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:strokeColor="@color/primary_green"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Thẻ 2: Quản lý Đơn hàng (UC15, UC16) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuanLyDonHang"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardQuanLySanPham"
        app:strokeColor="@color/divider_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Icon đầu mục trong khối bo góc 12dp nền cam pastel -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="@color/accent_orange_light"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📋"
                        android:textSize="20sp" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quản Lý Đơn Hàng "
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Duyệt đơn &amp; cập nhật trạng thái Realtime"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Theo dõi toàn bộ đơn đặt hàng từ khách hàng theo thời gian thực, tiến hành xác nhận duyệt đơn hoặc từ chối đơn hàng."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Nút bấm dạng pill shape -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuanLyDonHang"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="MỞ QUẢN LÝ ĐƠN HÀNG"
                android:textColor="@color/accent_orange"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:strokeColor="@color/accent_orange"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
