<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- Thanh tiêu đề Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        app:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon"
                android:contentDescription="Quay lại"
                android:src="@drawable/ic_back"
                app:tint="@color/primary_green" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Lịch sử đơn hàng"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <!-- Nút Làm mới thủ công -->
            <ImageButton
                android:id="@+id/btnLamMoi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon"
                android:contentDescription="Làm mới"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@color/primary_green" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Khu vực nội dung chính -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Danh sách đơn hàng -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLichSuDonHang"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_don_hang_customer" />

        <!-- Giao diện trống (Empty State) -->
        <LinearLayout
            android:id="@+id/layoutTrong"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:alpha="0.6"
                android:src="@drawable/ic_cart"
                app:tint="@color/primary_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Chưa có đơn hàng nào"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Bạn chưa đặt mua nông sản nào từ AgriClean. Hãy khám phá và ủng hộ các nhà vườn sạch nhé!"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKhamPhaNgay"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/primary_green"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="24dp"
                android:text="Khám phá nông sản ngay"
                android:textAllCaps="false"
                android:textColor="@color/bg_card"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_green"
            android:visibility="gone" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
