<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. Quyền kết nối mạng Internet phục vụ tải ảnh từ Firebase Storage và đồng bộ Firestore -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 2. Quyền sử dụng Camera để quét mã QR nguồn gốc nông sản -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Khai báo phần cứng Camera, đặt required="false" để máy không có camera sau vẫn cài đặt được -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 3. Quyền truy cập vị trí địa lý để tìm kiếm và chỉ đường tới nông trại gần nhất -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AGriClean">

        <!-- Màn hình khởi chạy chính của ứng dụng -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nhóm màn hình Xác thực người dùng (Auth) -->
        <activity
            android:name=".ui.auth.DangNhapActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.DangKyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Nhóm màn hình Quản trị viên (Admin) -->
        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.QuanLySanPhamActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.ThemSuaSanPhamActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.admin.QuanLyDonHangActivity"
            android:exported="false" />

        <!-- Nhóm màn hình Khách hàng (Customer) -->
        <activity
            android:name=".ui.customer.ChiTietSanPhamActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.GioHangActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.DatHangActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.customer.LichSuDonHangActivity"
            android:exported="false" />

        <!-- Đăng ký Activity quét mã QR của ZXing, cố định hướng màn hình dọc (portrait) -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

    </application>

</manifest>
